    "title": "Organelles of a Cell and Their Functions",
    "cards": [
      {
        "front": "What is the function of the nucleus in a cell?",
        "back": "The nucleus stores genetic material and controls cellular activities.",
        "tags": [
          "cell",
          "nucleus"
        ]
      },
      {
        "front": "What role does the mitochondria play in a cell?",
        "back": "The mitochondria is responsible for energy production through cellular respiration.",
        "tags": [
          "cell",
          "mitochondria"
        ]
      },
      {
        "front": "What is the function of ribosomes?",
        "back": "Ribosomes are responsible for protein synthesis.",
        "tags": [
          "cell",
          "ribosomes"
        ]
      },
      {
        "front": "What does the endoplasmic reticulum do?",
        "back": "The endoplasmic reticulum assists in the production and transport of proteins and lipids.",
        "tags": [
          "cell",
          "endoplasmic reticulum"
        ]
      },
      {
        "front": "What is the role of the Golgi apparatus?",
        "back": "The Golgi apparatus modifies, sorts, and packages proteins and lipids for transport.",
        "tags": [
          "cell",
          "Golgi apparatus"
        ]
      },
      {
        "front": "What is the function of lysosomes?",
        "back": "Lysosomes break down waste materials and cellular debris.",
        "tags": [
          "cell",
          "lysosomes"
        ]
      },
      {
        "front": "What does the cytoplasm do?",
        "back": "The cytoplasm provides a medium for chemical reactions and supports organelles.",
        "tags": [
          "cell",
          "cytoplasm"
        ]
      },
      {
        "front": "What is the role of the cell membrane?",
        "back": "The cell membrane regulates the movement of substances in and out of the cell.",
        "tags": [
          "cell",
          "cell membrane"
        ]
      },
      {
        "front": "What is the function of chloroplasts in plant cells?",
        "back": "Chloroplasts conduct photosynthesis to produce energy for the plant.",
        "tags": [
          "cell",
          "chloroplasts"
        ]
      },
      {
        "front": "What does the vacuole do in a cell?",
        "back": "The vacuole stores nutrients, waste products, and helps maintain cell structure.",
        "tags": [
          "cell",
          "vacuole"
        ]
      }
    ],
    "resourceName": "topic"
