# Copy this file to .env and fill in your values.
# Get these from a team member or the Azure portal.
# Never commit .env to git.

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
AZURE_OPENAI_QUIZ_GENERATOR_ENDPOINT=
AZURE_OPENAI_QUIZ_GENERATOR_API_KEY=
AZURE_OPENAI_QUIZ_GENERATOR_DEPLOYMENT_NAME=

# ── Cosmos DB ─────────────────────────────────────────────────────────────────
COSMOS_DB_URL=
COSMOS_DB_KEY=

# ── Azure AD (token validation) ───────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
AUTHORITY=https://login.microsoftonline.com/<your-tenant-id>

# ── Azure Blob Storage (voice notes) ─────────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_ACCOUNT_NAME=
AZURE_BLOB_ACCOUNT_KEY=
AZURE_BLOB_CONTAINER=audio
AZURE_BLOB_SAS_TTL_HOURS=0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins, e.g. http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# ── Local dev mode (optional) ─────────────────────────────────────────────────
# Set to true to skip Cosmos DB and use a local JSON file instead.
# Useful if you don't have Cosmos credentials yet.
# Note: Azure OpenAI keys are still required for AI features.
USE_LOCAL_JSON_STORE=false
COSMOS_FALLBACK_TO_LOCAL=1
